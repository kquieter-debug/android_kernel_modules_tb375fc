define_mgk_ko(
    name = "mtk-hcp",
    srcs = glob([
        "**/*.c",
        "**/*.h",
        "**/Kbuild",
        "**/Makefile",
    ]) +[
        "//common-modules/mediatek/vendor/mediatek/kernel_modules/mtkcam/imgsys:public_headers",
    ],

   # deps = [
   #     "//common-modules/mediatek/vendor/mediatek/kernel_modules/mtkcam/imgsys:imgsys",
   #      "//common-modules/mediatek/vendor/mediatek/kernel_modules/mtkcam/mtk-ipesys-me:mtk-ipesys-me",
   # ],

    outs = mgk_hcp_outs,
)
