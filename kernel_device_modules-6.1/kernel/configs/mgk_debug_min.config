# 最小调试配置：只保留模块产出所必需的开关。
#
# 背景：完整合并 userdebug.config 会改变 struct module 布局，导致 module_layout
# CRC 变成 0x9efa483d，与原厂模块（0xea759d7f）不兼容。因此只保留那些会产出
# .ko 的 =m 项，其余 MTK 调试开关一律不加。
CONFIG_MTK_IRQ_MONITOR=m
CONFIG_MTK_SELINUX_AEE_WARNING=m
CONFIG_MEDIATEK_CPUFREQ_DEBUG=m
CONFIG_PSTORE_BLK=m
CONFIG_PSTORE_BLK_BLKDEV="/dev/block/by-name/pstore"
CONFIG_PSTORE_BLK_CONSOLE_SIZE=4096
CONFIG_PSTORE_BLK_PMSG_SIZE=4096
CONFIG_PSTORE_BLK_KMSG_SIZE=2048
CONFIG_PSTORE_BLK_FTRACE_SIZE=4096
